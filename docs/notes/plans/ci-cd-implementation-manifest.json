{
  "manifest_metadata": {
    "project": "ai-slop-gate",
    "version": "2.1",
    "execution_mode": "STRICT_MODE",
    "enforcement_policy": "never_hallucinate",
    "instruction": "Use this JSON as the absolute source of truth for implementation. Do not invent new parameters.",
    "positioning": "Open-source, free, EU-oriented compliance-grade architecture"
  },
  "implementation_roadmap": [
    {
      "step": 1,
      "feature": "GitHub Action (plug-and-play)",
      "description": "Integrate into GitHub repository for automated analysis on push/pull_request.",
      "benefits": [
        "Easy integration",
        "Multi-provider support",
        "Configurable enforcement",
        "Stateless execution model"
      ]
    },
    {
      "step": 2,
      "feature": "Kubernetes Deployment Model",
      "description": "Provide production-ready Kubernetes deployment with stateless API replicas and worker replicas.",
      "sub_features": [
        "Stateless API layer",
        "Horizontal scaling support",
        "Health probes (liveness/readiness)",
        "Graceful shutdown",
        "ConfigMap and Secret integration"
      ],
      "benefits": [
        "Cloud-native deployment",
        "Enterprise readiness",
        "HA-ready architecture"
      ]
    },
    {
      "step": 3,
      "feature": "Cluster Mode (Production Default)",
      "description": "Distributed architecture with multiple API and Worker replicas using shared Redis state.",
      "requirements": [
        "API must remain stateless",
        "All job state externalized",
        "Idempotent job processing",
        "Retry with exponential backoff",
        "Dead-letter queue support",
        "Distributed locking with TTL"
      ],
      "benefits": [
        "Horizontal scalability",
        "Fault isolation",
        "Production reliability"
      ]
    },
    {
      "step": 4,
      "feature": "Storage Strategy (Phase 1 - Redis Primary)",
      "description": "Use Redis as primary storage for job state, cache, locking, and queue in early production phase.",
      "allowed_usage": [
        "Scan job state",
        "Temporary analysis results",
        "Rate limiting",
        "Distributed locks",
        "Queue management",
        "Cache"
      ],
      "forbidden_usage": [
        "Long-term audit logs",
        "Compliance history persistence",
        "Tenant billing data",
        "Security-critical audit storage"
      ],
      "requirements": [
        "AOF persistence enabled",
        "Snapshot backups configured",
        "Data-loss tolerance documented"
      ],
      "benefits": [
        "High performance",
        "Low operational complexity",
        "Fast MVP iteration"
      ]
    },
    {
      "step": 5,
      "feature": "Storage Evolution (Phase 2 - Hybrid Redis + Postgres)",
      "description": "Introduce PostgreSQL as authoritative store when scale or compliance requirements increase.",
      "redis_role": [
        "Cache",
        "Queue",
        "Locks",
        "Hot data"
      ],
      "postgres_role": [
        "Compliance results",
        "Audit trails",
        "Tenant configuration",
        "User data",
        "Scoring history"
      ],
      "architecture_requirements": [
        "Repository abstraction layer",
        "Storage-agnostic domain model",
        "Migration strategy defined",
        "Schema versioning"
      ],
      "benefits": [
        "Compliance readiness",
        "Audit-grade persistence",
        "Enterprise adoption"
      ]
    },
    {
      "step": 6,
      "feature": "Reliability Model",
      "description": "Define SLO, graceful shutdown strategy, and failure domains.",
      "requirements": [
        "SLO definition (availability & latency)",
        "Failure domain separation (API, Worker, Redis, LLM)",
        "Graceful shutdown handling",
        "Backpressure strategy"
      ],
      "benefits": [
        "Operational clarity",
        "Predictable scaling",
        "Enterprise trust"
      ]
    },
    {
      "step": 7,
      "feature": "Security Architecture (Zero Trust Internal Model)",
      "description": "Apply European-grade security practices while remaining open-source.",
      "requirements": [
        "mTLS between services (future phase)",
        "Secrets management via Vault or sealed secrets",
        "No hardcoded credentials",
        "Private network segmentation for Redis and DB",
        "RBAC model"
      ],
      "benefits": [
        "EU compliance alignment",
        "Enterprise readiness",
        "Secure-by-design approach"
      ]
    },
    {
      "step": 8,
      "feature": "Observability Foundation",
      "description": "Introduce structured logging and metrics for cluster deployments.",
      "requirements": [
        "Structured logs",
        "Centralized logging support",
        "Metrics endpoint",
        "Error-rate monitoring",
        "Future tracing support"
      ],
      "benefits": [
        "Operational transparency",
        "Faster debugging",
        "Production monitoring readiness"
      ]
    }
  ],
  "technical_matrix": {
    "target_audiences": [
      "Developers",
      "DevOps",
      "SRE",
      "Security Teams",
      "Enterprise"
    ],
    "critical_components": [
