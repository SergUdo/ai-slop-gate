{
  "snapshot_version": "7.4.0",
  "project": {
    "name": "ai-slop-gate",
    "stage": "Stage 1",
    "status": "canonical",
    "purpose": "Policy-driven AI, supply-chain and compliance gate for code and infrastructure"
  },
  "supported_languages": [
    {
      "language": "Ruby",
      "support_level": "full",
      "providers": ["StaticRubyProvider"]
    },
    {
      "language": "Python",
      "support_level": "full",
      "providers": ["StaticPythonProvider"]
    },
    {
      "language": "JavaScript",
      "support_level": "full",
      "providers": ["StaticJSProvider", "StaticTSJSProvider", "ESLintProvider"]
    },
    {
      "language": "TypeScript",
      "support_level": "full",
      "providers": ["StaticTSJSProvider", "ESLintProvider"]
    },
    {
      "language": "Java",
      "support_level": "full",
      "providers": ["StaticJavaProvider"]
    },
    {
      "language": "C++",
      "support_level": "full",
      "providers": ["StaticCppProvider"]
    },
    {
      "language": "C#",
      "support_level": "full",
      "providers": ["StaticCSharpProvider"]
    },
    {
      "language": "Docker",
      "support_level": "full",
      "providers": ["StaticDockerProvider"]
    },
    {
      "language": "Kubernetes",
      "support_level": "full",
      "providers": ["KubernetesStaticProvider", "K8sRuntimeProvider"]
    },
    {
      "language": "Terraform",
      "support_level": "full",
      "providers": ["TerraformStaticProvider", "TerraformPlanProvider"]
    }
  ],
  "principles": {
    "no_hidden_logic": true,
    "policy_is_source_of_truth": true,
    "compliance_is_sidecar": true,
    "engine_is_pure": true,
    "cli_is_thin": true,
    "tests_lock_contracts_not_behavior": true,
    "cache_is_cost_control_not_performance": true
  },
  "execution_model": {
    "flow": [
      "CLI parses flags",
      "Policy is loaded and resolved",
      "Providers collect or analyze inputs",
      "LLM providers are optionally wrapped by CachedProvider",
      "Compliance sidecar optionally runs",
      "Policy engine evaluates observations",
      "Decision is produced",
      "Reporters render output",
      "Exit code is derived from decision",
      "Release pipeline runs (determine version → build → sign → publish)"
    ]
  },
  "cli": {
    "entrypoint": "python -m ai_slop_gate.cli.main",
    "commands": ["init", "run"],
    "responsibility": "argument parsing and wiring only",
    "flags": {
      "--policy": "Path to policy.yml (required for run)",
      "--provider": "Provider name (static, k8s-runtime, supply-chain, llm)",
      "--input-file": "Input file for providers",
      "--compliance": "Force enable compliance sidecar",
      "--profile": "Override compliance profile",
      "--enforcement": "never | advisory | blocking",
      "--verbose": "Emit full resolved state and observations",
      "--github-checks": "Emit GitHub Checks",
      "--github-repo": "GitHub repository",
      "--github-sha": "Commit SHA",
      "--pr-id": "Pull Request ID"
    }
  },
  "engine": {
    "type": "function-based",
    "entry": "run_analysis(args) -> Decision",
    "responsibilities": [
      "load policy",
      "resolve effective compliance config",
      "invoke providers",
      "merge observations",
      "invoke policy engine",
      "return decision"
    ],
    "restrictions": [
      "no IO formatting",
      "no printing",
      "no exit calls"
    ]
  },
  "policy": {
    "format": "policy.yml",
    "versioned": true,
    "sections": [
      "enforcement",
      "ai_provider",
      "compliance",
      "profiles",
      "rules"
    ],
    "rules_engine": {
      "inputs": "observations",
      "outputs": "Decision(mode, reasons)"
    }
  },
  "providers": {
    "contract": {
      "static": "collect(input) -> list[Observation]",
      "llm": "analyze(inputs) -> list[Observation]"
    },
    "builtins": [
      "StaticProvider",
      "StaticSecurityProvider",
      "StaticPipelineProvider",
      "ESLintProvider",
      "StaticDockerProvider",
      "StaticJSProvider",
      "StaticPythonProvider",
      "StaticTSJSProvider",
      "K8sRuntimeProvider",
      "KubernetesStaticProvider",
      "TerraformPlanProvider",
      "TerraformStaticProvider",
      "SupplyChainProvider",
      "TrivyProvider",
      "SBOMProvider",
      "StaticRubyProvider",
      "StaticJavaProvider",
      "StaticCSharpProvider",
      "StaticCppProvider"
    ]
  },
  "cache": {
    "purpose": "Prevent repeated LLM token spending",
    "scope": "LLM providers only",
    "integration": "via CachedProvider wrapper",
    "non_goals": [
      "performance optimization",
      "caching static providers",
      "cross-provider result sharing"
    ],
    "cache_key": {
      "version": "v1",
      "components": [
        "provider_id",
        "model",
        "profile",
        "policy_hash",
        "normalized_input_fingerprint"
      ],
      "guarantee": "same key MUST NOT trigger LLM call twice"
    },
    "backends": {
      "file": {
        "usage": "default runtime cache",
        "location": ".ai-slop-cache/",
        "tracked_in_git": false
      },
      "memory": {
        "usage": "tests only"
      }
    },
    "invalidations": [
      "input content change",
      "policy change",
      "profile change",
      "model change"
    ]
  },
  "compliance": {
    "role": "sidecar",
    "enabled_by": ["policy.compliance.enabled", "--compliance flag"],
    "capabilities": [
      "forbidden license detection",
      "secret detection",
      "data residency enforcement (EU)"
    ],
    "profiles": {
      "default": "inherits base compliance config",
      "eu": "enforces GPL/AGPL ban and EU residency",
      "eu-strict": "blocking enforcement"
    }
  },
  "observations": {
    "immutable": true,
    "fields": [
      "category",
      "signal",
      "confidence",
      "evidence",
      "source"
    ]
  },
  "decision": {
    "modes": ["allow", "advisory", "blocking"],
    "exit_code_mapping": {
      "allow": 0,
      "advisory": 0,
      "blocking": 1
    }
  },
  "reporters": {
    "stdout": "human-readable",
    "github_pr": "PR comment",
    "github_checks": "check-run annotations"
  },
  "tests": {
    "philosophy": "lock architectural contracts, not implementation",
    "critical_invariants": [
      "LLM token is not spent twice for same cache key",
      "cache key changes on input or policy change",
      "static providers are never cached"
    ]
  },
  "non_goals": [
    "automatic fixing",
    "code rewriting",
    "business logic inside CLI",
    "provider-specific policy logic",
    "caching for non-LLM providers"
  ],
  "distribution": {
    "registry": "ghcr.io/public",
    "visibility": "public",
    "purpose": "Open-source distribution of images for easy CI/CD integration"
  },
  "release": {
    "pipeline": {
      "name": "release.yml",
      "trigger": {
        "on": ["push: tags v*.*.*", "workflow_dispatch"]
      },
      "purpose": "Build multi-arch release images, bump version, generate changelog, sign and publish to GHCR",
      "steps": [
        "determine_semver_and_create_tag",
        "generate_changelog",
        "build_multi_arch_images",
        "run_trivy_on_release_image",
        "generate_sbom_for_release_image",
        "sign_images_with_cosign",
        "publish_images_to_registry",
        "upload_artifacts_and_reports"
      ]
    },
    "versioning": {
      "strategy": "semantic",
      "rules": {
        "fix": "patch",
        "feat": "minor",
        "BREAKING CHANGE": "major"
      },
      "tag_prefix": "v"
    },
    "changelog": {
      "generator": "metcalfc/changelog-generator@v4",
      "source": "commit messages between tags",
      "output": "CHANGELOG.md and GitHub Release body"
    },
    "multi_arch": {
      "platforms": ["linux/amd64", "linux/arm64"],
      "builder": "docker buildx",
      "manifest": "single multi-arch manifest pushed to GHCR"
    },
    "signing": {
      "tool": "cosign",
      "mode": "key-pair",
      "public_key_location": "repo root /cosign.pub (public)",
      "required_secrets": ["COSIGN_PRIVATE_KEY", "COSIGN_PASSWORD"]
    },
    "sbom_and_scanning": {
      "sbom_tool": "anchore/sbom-action (syft)",
      "vuln_scanner": "trivy",
      "scan_target": "release image tag(s)",
      "artifacts": ["sbom-spdx.json", "trivy-results.sarif"]
    },
    "publishing": {
      "registry": "ghcr.io/${{ github.repository }}",
      "tags_emitted": ["vX.Y.Z", "latest (default branch only)", "sha-<short>"],
      "visibility": "public",
      "signing_verified": true
    },
    "artifacts": {
      "upload": ["sbom-spdx.json", "trivy-results.sarif", "CHANGELOG.md"]
    }
  },
  "secrets_required_for_release": {
    "GHCR_TOKEN": "write access to packages (publish)",
    "COSIGN_PRIVATE_KEY": "contents of cosign.key (private)",
    "COSIGN_PASSWORD": "password protecting cosign.key",
    "GITHUB_TOKEN": "automated changelog/release creation (default secret)"
  }
}